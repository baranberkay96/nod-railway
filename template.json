{
  "name": "Nod Personal AI Agent with Its Own Computer",
  "description": "n8n's open-source personal agent with a Linux workspace and browser",
  "category": "AI/ML",
  "tags": [
    "nod",
    "n8n",
    "ai-agent",
    "personal-assistant",
    "browser-automation",
    "computer-use",
    "self-hosted"
  ],
  "image": "https://cdn.jsdelivr.net/gh/n8n-io/nod@6cebbf1a448eba950d97e907bef8435e3a4e8b33/public/favicon.svg",
  "upstream": {
    "nod": "n8n-io/nod (Apache-2.0) nod-v0.9.0, commit 6cebbf1a448eba950d97e907bef8435e3a4e8b33 (2026-11-19); built from source",
    "checked": "2026-11-20"
  },
  "services": {
    "Nod": {
      "icon": "https://cdn.jsdelivr.net/gh/n8n-io/nod@6cebbf1a448eba950d97e907bef8435e3a4e8b33/public/favicon.svg",
      "source": {
        "repo": "baranberkay96/nod-railway",
        "rootDirectory": "/services/server"
      },
      "startCommand": null,
      "healthcheckPath": null,
      "healthcheckTimeout": null,
      "restartPolicyType": "ALWAYS",
      "publicDomain": true,
      "targetPort": 4310,
      "tcpProxy": null,
      "volume": {
        "mountPath": "/var/lib/nod"
      },
      "variables": {
        "PORT": {
          "defaultValue": "4310",
          "description": "Port of Nod's web app and API (public domain target).",
          "required": true
        },
        "NOD_PUBLIC_URL": {
          "defaultValue": "https://${{RAILWAY_PUBLIC_DOMAIN}}",
          "description": "Exact HTTPS origin people open; Nod refuses other hosts. Change it when you add a custom domain.",
          "required": true
        },
        "NOD_AUTH_TOKEN": {
          "defaultValue": "${{secret(48, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-\")}}",
          "description": "Access token you enter to open Nod (full access to your assistant). Generated; 43+ chars of A-Z a-z 0-9 _ -.",
          "required": true
        },
        "NOD_VAULT_KEY": {
          "defaultValue": "${{secret(42, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789+/\")}}${{secret(1, \"AEIMQUYcgkosw048\")}}=",
          "description": "Encrypts saved model keys and connections (32 bytes, base64). Generated; back it up and never change it.",
          "required": true
        },
        "DATABASE_URL": {
          "defaultValue": "${{Postgres.DATABASE_URL}}",
          "description": "Postgres in this project.",
          "required": true
        },
        "NOD_RELAY_TOKEN": {
          "defaultValue": "${{secret(48)}}",
          "description": "Shared secret between Nod and its workspace and browser services. Generated.",
          "required": true
        },
        "NOD_WORKSPACE_RELAY": {
          "defaultValue": "${{workspace.RAILWAY_PRIVATE_DOMAIN}}:7070",
          "description": "Workspace service relay on the private network.",
          "required": true
        },
        "NOD_BROWSER_RELAY": {
          "defaultValue": "${{browser.RAILWAY_PRIVATE_DOMAIN}}:7070",
          "description": "Browser service relay on the private network.",
          "required": true
        },
        "NOD_ANALYTICS_ENABLED": {
          "defaultValue": "false",
          "description": "Anonymous product analytics to n8n (true/false). Off by default here.",
          "required": false
        }
      }
    },
    "workspace": {
      "icon": "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/debian-linux.svg",
      "source": {
        "repo": "baranberkay96/nod-railway",
        "rootDirectory": "/services/workspace"
      },
      "startCommand": null,
      "healthcheckPath": null,
      "healthcheckTimeout": null,
      "restartPolicyType": "ALWAYS",
      "publicDomain": false,
      "targetPort": null,
      "tcpProxy": null,
      "volume": {
        "mountPath": "/workspace"
      },
      "variables": {
        "NOD_RELAY_TOKEN": {
          "defaultValue": "${{Nod.NOD_RELAY_TOKEN}}",
          "description": "Must equal the Nod service's relay token (referenced; edit it there).",
          "required": true
        },
        "NOD_RELAY_PORT": {
          "defaultValue": "7070",
          "description": "Private relay port Nod connects to.",
          "required": true
        }
      }
    },
    "browser": {
      "icon": "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/chromium.svg",
      "source": {
        "repo": "baranberkay96/nod-railway",
        "rootDirectory": "/services/browser"
      },
      "startCommand": null,
      "healthcheckPath": null,
      "healthcheckTimeout": null,
      "restartPolicyType": "ALWAYS",
      "publicDomain": false,
      "targetPort": null,
      "tcpProxy": null,
      "volume": {
        "mountPath": "/data"
      },
      "variables": {
        "NOD_RELAY_TOKEN": {
          "defaultValue": "${{Nod.NOD_RELAY_TOKEN}}",
          "description": "Must equal the Nod service's relay token (referenced; edit it there).",
          "required": true
        },
        "NOD_RELAY_PORT": {
          "defaultValue": "7070",
          "description": "Private relay port Nod connects to.",
          "required": true
        }
      }
    },
    "Postgres": {
      "icon": "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/postgresql.svg",
      "source": {
        "image": "ghcr.io/railwayapp-templates/postgres-ssl:17.11@sha256:5e806d28c18198f933d25e79989470a47a938f465bf0634e030b416961b3463e"
      },
      "restartPolicyType": "ALWAYS",
      "publicDomain": false,
      "volume": {
        "mountPath": "/var/lib/postgresql/data"
      },
      "variables": {
        "PGDATA": {
          "defaultValue": "/var/lib/postgresql/data/pgdata",
          "description": "Location where the database will be initialized",
          "required": true
        },
        "PGHOST": {
          "defaultValue": "${{RAILWAY_PRIVATE_DOMAIN}}",
          "description": "Railway Private Domain Name.",
          "required": true
        },
        "PGPORT": {
          "defaultValue": "5432",
          "description": "Port to connect to Postgres.",
          "required": true
        },
        "PGUSER": {
          "defaultValue": "${{ POSTGRES_USER }}",
          "description": "Required variable for Data panel",
          "required": true
        },
        "PGDATABASE": {
          "defaultValue": "${{POSTGRES_DB}}",
          "description": "Required variable for the data panel.",
          "required": true
        },
        "PGPASSWORD": {
          "defaultValue": "${{POSTGRES_PASSWORD}}",
          "description": "Required variable for Data panel",
          "required": true
        },
        "POSTGRES_DB": {
          "defaultValue": "railway",
          "description": "Default database created when image is started.",
          "required": true
        },
        "DATABASE_URL": {
          "defaultValue": "postgresql://${{PGUSER}}:${{POSTGRES_PASSWORD}}@${{RAILWAY_PRIVATE_DOMAIN}}:5432/${{PGDATABASE}}",
          "description": "URL to connect to Postgres (Nod's threads, memory, schedules, connections).",
          "required": true
        },
        "POSTGRES_USER": {
          "defaultValue": "postgres",
          "description": "User to connect to Postgres DB",
          "required": true
        },
        "SSL_CERT_DAYS": {
          "defaultValue": "820",
          "description": "SSL certificate expiry in days.",
          "required": false
        },
        "POSTGRES_PASSWORD": {
          "defaultValue": "${{ secret(32, \"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ\") }}",
          "description": "Password to connect to DB",
          "required": true
        },
        "RAILWAY_DEPLOYMENT_DRAINING_SECONDS": {
          "defaultValue": "60",
          "description": "Allow Postgres to cleanly shut down",
          "required": true
        }
      }
    }
  }
}